# Copy this file to .env and fill in your own values. .env is gitignored.

# Which model backs the agents: stub | claude | openai
# stub needs no key and no install - it fakes replies so the loop runs offline.
AGENT_PROVIDER=stub

# Anthropic Claude (used when AGENT_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# OpenAI (used when AGENT_PROVIDER=openai). gpt-5-mini matches what the CRM uses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Rough cap on how much conversation history is sent each turn (estimated tokens).
# When history grows past this, the oldest turns are dropped.
MAX_CONTEXT_TOKENS=4000
